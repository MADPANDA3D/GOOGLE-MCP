# Choose exactly one startup access mode: standalone or portal.
MCP_MODE=standalone

# Required only in standalone mode. Generate a unique random value of at least
# 32 characters; this authenticates callers to the MCP server.
MCP_ACCESS_TOKEN=

# Required only in Portal mode. This is a service-to-service grant, not a Google
# credential and not a user-facing API key.
MCP_PORTAL_GRANT_TOKEN=
MCP_PORTAL_GRANT_HEADER=x-madpanda-portal-grant

# Immutable release identity. Released images publish the exact digest.
MCP_RUNTIME_IMAGE=google-mcp:local-source
MCP_IMAGE_REFERENCE=development
MCP_BUILD_SHA=development
MCP_SOURCE_FINGERPRINT=development
MCP_HOST_PORT=8086

# Comma-separated Host values accepted by the service. Add only the hostnames
# used by your trusted reverse proxy or local client.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,google-mcp
MCP_ALLOWED_ORIGINS=

# Request-scoped Google BYOK headers. Provider secrets never belong in this file.
MCP_GOOGLE_CLIENT_ID_HEADER=x-google-client-id
MCP_GOOGLE_CLIENT_SECRET_HEADER=x-google-client-secret
MCP_GOOGLE_REFRESH_TOKEN_HEADER=x-google-refresh-token
MCP_GOOGLE_MAPS_API_KEY_HEADER=x-google-maps-api-key
MCP_ALLOW_REQUEST_OVERRIDES=true
MCP_REQUIRE_REQUEST_GOOGLE_CLIENT_ID=true
MCP_REQUIRE_REQUEST_GOOGLE_CLIENT_SECRET=true
MCP_REQUIRE_REQUEST_GOOGLE_REFRESH_TOKEN=true
MCP_DISABLE_DEFAULT_GOOGLE_FALLBACK=true
MCP_BYOK_CLIENT_CACHE_SIZE=0
MCP_BYOK_CLIENT_CACHE_TTL_SECONDS=0

# Bounded, fail-closed runtime defaults.
MCP_REQUEST_BODY_MAX_BYTES=8388608
MCP_PROVIDER_RESPONSE_MAX_BYTES=4194304
MCP_TOOL_OUTPUT_MAX_BYTES=2097152
MCP_MAX_DOWNLOAD_BYTES=5000000
MCP_MAX_BATCH_ITEMS=1000
MCP_MAX_PROVIDER_CALLS_PER_TOOL=128
MCP_WORKERS=1
MCP_LOG_REQUESTS=false
